[Unit]
Description=HydroPi Terminal Dashboard
After=multi-user.target tilt-scanner.service
Wants=tilt-scanner.service

[Service]
Type=simple
User=__USER__
Group=__USER__
ExecStart=__BASEDIR__/venv/bin/python __BASEDIR__/scripts/dashboard.py
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
